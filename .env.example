# Copy to .env and fill in real values. docker-compose.yml and the n8n workflow
# read these. NEVER commit the resulting .env (it is gitignored).
#
# Every var here maps to a $env.* reference inside workflow/n8n-workflow.json
# or to a service in docker-compose.yml. All values below are placeholders.

# ============================================================
# PostHog — first-party product events (self-hosted or Cloud)
# ============================================================
# The workflow QUERIES PostHog to compute cumulative usage thresholds.
POSTHOG_HOST=https://posthog.example          # your PostHog base URL (no trailing slash)
POSTHOG_PROJECT_ID=REPLACE_ME                  # numeric project id (Settings → Project)
POSTHOG_API_KEY=REPLACE_ME                     # Personal API key with `query:read` scope

# ============================================================
# n8n + its Postgres store (docker-compose)
# ============================================================
# Generate a long random string (32+ chars). Required by recent n8n versions.
N8N_ENCRYPTION_KEY=change_me_to_a_long_random_32char_string
POSTGRES_PASSWORD=n8n_local_password_change_me

# ============================================================
# LiteLLM proxy — drafts the context-aware message
# ============================================================
# Bearer token the n8n workflow sends to YOUR LiteLLM proxy (you choose it).
LITELLM_MASTER_KEY=sk-REPLACE_ME_local_proxy_key
# Upstream LLM provider key the proxy uses (Anthropic / OpenAI / Gemini / ...).
LLM_PROVIDER_API_KEY=REPLACE_ME

# ============================================================
# Twenty CRM — where the lead + draft are written
# ============================================================
TWENTY_API_URL=https://twenty.example/graphql  # your Twenty GraphQL endpoint
TWENTY_API_KEY=REPLACE_ME                       # Settings → APIs & Webhooks → API key

# ============================================================
# Slack — where the rep is notified (human-in-the-loop)
# ============================================================
SLACK_BOT_TOKEN=REPLACE_ME                      # bot token, needs chat:write
SLACK_CHANNEL_ID=REPLACE_ME                     # target channel id (e.g. C0123ABC)

# ============================================================
# Workflow behavior
# ============================================================
# START IN DRY-RUN. When true, the workflow computes the trigger and drafts the
# message but does NOT write to Twenty, notify Slack, or record a send.
DRY_RUN=true
